// Finora — esquema de base de datos.
//
// Reglas clave (ver también las CHECK constraints añadidas a mano en la migración inicial):
// - Todos los montos son BigInt en unidades mínimas de la moneda (COP = pesos enteros, USD = centavos).
// - El saldo de una cuenta NO se almacena: se deriva de sus movimientos (libro contable).
// - INCOME / EXPENSE / TRANSFER siempre tienen amount > 0; el signo lo da el tipo.
// - OPENING_BALANCE / ADJUSTMENT llevan signo (≠ 0). El saldo inicial positivo cuenta como ingreso en las
//   estadísticas (services/analytics.ts); el ajuste y el saldo inicial negativo no son ingreso ni gasto.
// - Los movimientos se eliminan de forma suave (deletedAt) y se pueden restaurar.
// - Multiusuario: cada usuario ve SOLO sus datos. Los servicios siempre filtran por userId.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum AccountType {
  BANK
  DIGITAL_WALLET
  CASH
  CRYPTO
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  OPENING_BALANCE
  ADJUSTMENT
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

/// Persona que usa Finora. Sus datos son privados.
model User {
  id                String    @id @default(cuid())
  /// Nombre para iniciar sesión (minúsculas, sin espacios).
  username          String    @unique
  /// Nombre para mostrar.
  name              String
  /// "scrypt:<sal>:<hash>". Un valor sin ese formato bloquea el acceso hasta definir contraseña.
  passwordHash      String
  /// Sube al cambiar la contraseña o al cerrar todas las sesiones: invalida las cookies anteriores.
  sessionVersion    Int       @default(0)
  /// Aceptación de la política de tratamiento de datos (versión y fecha).
  privacyVersion    Int?
  privacyAcceptedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  goals        SavingsGoal[]
  rates        ExchangeRate[]
  settings     Setting[]
}

model Account {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      AccountType
  /// Código ISO-4217 o de activo (COP, USD, USDT...).
  currency  String      @default("COP")
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  transactions      Transaction[] @relation("TransactionAccount")
  incomingTransfers Transaction[] @relation("TransferDestination")
  goals             SavingsGoal[]

  @@unique([userId, name])
  @@index([userId])
}

model Category {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  kind       CategoryKind
  /// Nombre de icono (lucide) usado por la UI.
  icon       String       @default("circle")
  color      String       @default("#64748b")
  isDefault  Boolean      @default(false)
  isArchived Boolean      @default(false)
  sortOrder  Int          @default(0)
  /// Categoría del sistema (ej. "goal-saving" para los aportes a metas); null = del usuario.
  systemKey  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  transactions Transaction[]
  budget       Budget?

  @@unique([userId, name, kind])
  @@unique([userId, systemKey])
  @@index([userId])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TransactionType
  /// Unidades mínimas de la moneda de `account`.
  amount      BigInt
  accountId   String
  account     Account         @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  /// Solo para TRANSFER: cuenta destino.
  toAccountId String?
  toAccount   Account?        @relation("TransferDestination", fields: [toAccountId], references: [id], onDelete: Restrict)
  /// Solo para TRANSFER: monto recibido en la moneda de la cuenta destino.
  toAmount    BigInt?
  /// Obligatoria para INCOME / EXPENSE; nula para el resto.
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Momento del movimiento (UTC). Los rangos de fechas se calculan en America/Bogota.
  date        DateTime
  description String
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  /// Si es el movimiento de un aporte/retiro de meta (se gestiona desde Metas).
  goalContribution GoalContribution?

  @@index([userId, date])
  @@index([accountId])
  @@index([toAccountId])
  @@index([categoryId])
  @@index([type, date])
  @@index([deletedAt])
}

model Budget {
  id         String   @id @default(cuid())
  categoryId String   @unique
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Límite mensual en COP (se aplica cada mes).
  amount     BigInt
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SavingsGoal {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  /// Objetivo en COP.
  targetAmount BigInt
  targetDate   DateTime?
  /// Cuenta sugerida para los aportes (de ahí sale el dinero por defecto).
  accountId    String?
  account      Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  status       GoalStatus @default(ACTIVE)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  contributions GoalContribution[]

  @@index([userId])
}

model GoalContribution {
  id            String       @id @default(cuid())
  goalId        String
  goal          SavingsGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  /// COP. Positivo = aporte, negativo = retiro de la meta.
  amount        BigInt
  date          DateTime
  note          String?
  /// Movimiento que sacó (gasto) o devolvió (ingreso) el dinero de una cuenta.
  /// Null = dinero que ya estaba aparte (ej. "ya ahorrado" al crear la meta).
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([goalId])
}

/// Tasa manual para convertir otras monedas a COP.
model ExchangeRate {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency   String
  /// COP por 1 unidad mayor de `currency`, escalado ×1.000.000.
  rateMicros BigInt
  updatedAt  DateTime @updatedAt

  @@id([userId, currency])
}

/// Preferencias clave/valor (onboarding, umbral de gastos hormiga, etc.).
model Setting {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([userId, key])
}

/// Intentos fallidos de inicio de sesión por usuario (freno compartido entre servidores).
model LoginAttempt {
  username    String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}
